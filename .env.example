# ════════════════════════════════════════════════════════
# FICHIER D'EXEMPLE DE CONFIGURATION — HOSPITOS ENGINE
# Modifiez ces variables pour personnaliser la plateforme pour chaque hôtel client.
# ════════════════════════════════════════════════════════

# ── Environnement de l'application (development | production) ──
APP_ENV=production
SYSTEM_NAME="HospitOS"
SYSTEM_VERSION="2.0.0"

# ── Identité & Marque Blanche de l'Hôtel ──
HOTEL_NAME="Hôtel Grand Prestige & Spa"
HOTEL_NAME_SHORT="Grand Prestige"
HOTEL_INITIALS="GP"
HOTEL_TAGLINE="L'Excellence · Le Confort · L'Hospitalité"
HOTEL_LOCATION="Avenue Océane, Front de Mer"
HOTEL_CITY="Lomé"
HOTEL_COUNTRY="Togo"
HOTEL_PHONE="+228 90 00 00 00"
HOTEL_WHATSAPP="22890000000"
HOTEL_EMAIL="reservations@grandprestige-hotel.com"
HOTEL_CONTACT_EMAIL="contact@grandprestige-hotel.com"
HOTEL_CURRENCY="FCFA"
HOTEL_REF_PREFIX="HTL"
HOTEL_CLIENT_PREFIX="CLI"

# ── Charte Graphique & Design Tokens CSS ──
THEME_COLOR_PRIMARY="#1a3a2a"
THEME_COLOR_PRIMARY_LIGHT="#2d5c40"
THEME_COLOR_ACCENT="#b89035"
THEME_COLOR_ACCENT_LIGHT="#d4a948"
THEME_COLOR_ACCENT_PALE="#f5e9c4"
THEME_COLOR_DARK="#111111"
THEME_COLOR_LIGHT="#faf8f3"

# ── Base de données MySQL ──
DB_HOST=localhost
DB_NAME=seguro_hotel
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ── Service d'envoi d'emails transactionnels (Brevo API) ──
BREVO_API_KEY=votre_cle_api_brevo_ici
BREVO_SENDER_EMAIL=reservations@grandprestige-hotel.com
BREVO_SENDER_NAME="Grand Prestige — Conciergerie"
