# ════════════════════════════════════════════════════════
# FICHIER D'EXEMPLE DE CONFIGURATION D'ENVIRONNEMENT
# Copiez ce fichier sous le nom '.env' et renseignez vos clés réelles.
# NE COMMITEZ JAMAIS LE FICHIER '.env' SUR GITHUB !
# ════════════════════════════════════════════════════════

# Environnement de l'application (development | production)
APP_ENV=production

# Base de données MySQL
DB_HOST=localhost
DB_NAME=seguro_hotel
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Service d'envoi d'emails transactionnels (Brevo API)
BREVO_API_KEY=votre_cle_api_brevo_ici
BREVO_SENDER_EMAIL=reservations@hotelseguro.com
BREVO_SENDER_NAME="Hôtel SEGURO — Conciergerie"

# Coordonnées Établissement
HOTEL_NAME="Hôtel SEGURO"
HOTEL_TAGLINE="La Sérénité · La Qualité · La Confiance"
HOTEL_LOCATION="Agbodrafo, entrée de Aného, Togo"
HOTEL_PHONE="+228 90 00 00 00"
HOTEL_WHATSAPP="22890000000"
HOTEL_EMAIL="reservations@hotelseguro.com"
HOTEL_CONTACT_EMAIL="contact@hotelseguro.com"
